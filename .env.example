SOPHIE_VOICE_PORT=3002
SYNAPSE_SESSION_RECORDING_DIR=.synapse/sessions
SYNAPSE_PRODUCT_ID=sophie
SYNAPSE_AGENT_ID=sophie
SYNAPSE_USER_ID=dev-user
SYNAPSE_CHANNEL=voice
SYNAPSE_USER_TIMEZONE=Europe/London
SYNAPSE_CONSENT_SCOPE=conversation_memory
SOPHIE_STT_BACKEND=elevenlabs-realtime
# Conservative word-logprob thresholds for the one-turn clarification overlay.
SOPHIE_STT_MIN_AVERAGE_LOGPROB=-0.7
SOPHIE_STT_MIN_WORD_LOGPROB=-1.5
SOPHIE_TTS_BACKEND=lemonfox
SOPHIE_LEMONFOX_VOICE=aoede
SOPHIE_MIN_SILENCE_MS=900
SOPHIE_MIN_SPEECH_MS=384
SOPHIE_MIN_SPEECH_CONTINUATION_MS=384
SOPHIE_SPECULATIVE_REOPEN_MS=3000
SOPHIE_UNANSWERED_REOPEN_MS=12000
SOPHIE_PROMPT_MODE=compact
SOPHIE_PROMPT_DEPTH=auto
# Development only: logs the complete compiled system prompt.
SOPHIE_LOG_COMPILED_PROMPT=false

# Brain: companion-runtime owns prompt, memory, tools, model selection.
COMPANION_RUNTIME_URL=http://127.0.0.1:8080
COMPANION_RUNTIME_SECRET=your_brain_secret_here
LEMONFOX_API_KEY=your_lemonfox_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
