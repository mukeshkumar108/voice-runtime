VOICE_PORT=3002
SYNAPSE_SESSION_RECORDING_DIR=.synapse/sessions
SYNAPSE_PRODUCT_ID=sophie
SYNAPSE_AGENT_ID=sophie
SYNAPSE_USER_ID=dev-user
SYNAPSE_CHANNEL=voice
SYNAPSE_USER_TIMEZONE=Europe/London
SYNAPSE_CONSENT_SCOPE=conversation_memory
VOICE_STT_BACKEND=elevenlabs-realtime
# Conservative word-logprob thresholds for the one-turn clarification overlay.
VOICE_STT_MIN_AVERAGE_LOGPROB=-0.7
VOICE_STT_MIN_WORD_LOGPROB=-1.5
VOICE_TTS_BACKEND=lemonfox
VOICE_LEMONFOX_VOICE=aoede
VOICE_MIN_SILENCE_MS=900
VOICE_MIN_SPEECH_MS=384
VOICE_MIN_SPEECH_CONTINUATION_MS=384
VOICE_SPECULATIVE_REOPEN_MS=3000
VOICE_UNANSWERED_REOPEN_MS=12000

# Brain: companion-runtime owns prompt, memory, tools, model selection.
VOICE_RUNTIME_URL=http://127.0.0.1:8080
VOICE_RUNTIME_SECRET=your_brain_secret_here
LEMONFOX_API_KEY=your_lemonfox_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Legacy aliases (still honoured with a DEPRECATED warning, prefer VOICE_*):
# SOPHIE_VOICE_PORT, SOPHIE_STT_BACKEND, SOPHIE_TTS_BACKEND,
# SOPHIE_LEMONFOX_VOICE, SOPHIE_MIN_SILENCE_MS, SOPHIE_MIN_SPEECH_MS,
# SOPHIE_MIN_SPEECH_CONTINUATION_MS, SOPHIE_SPECULATIVE_REOPEN_MS,
# SOPHIE_UNANSWERED_REOPEN_MS, COMPANION_RUNTIME_URL, COMPANION_RUNTIME_SECRET
